# ─────────────────────────────────────────────────────────────────────────────
#  المساعد الذكي على السوشيال ميديا — متغيرات البيئة
#  انسخ اللي محتاجه من هنا وحطه في Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── المخ ──
# فيه تلات مستويات، والكود بيختار الأعلى المتاح لوحده:
#
#   1) ANTHROPIC_API_KEY موجود  → Claude يرد على كل حاجة (مدفوع)
#   2) مفيش، وفيه GEMINI_API_KEY → Gemini يرد (طبقة مجانية: 1500 رسالة/يوم)
#   3) مفيش الاتنين              → محرك القواعد بس (ردود أقل ذكاءً، بس الشات
#                                   مش هيقف — وده مقصود)
#
# ولو أي موديل فشل أو وقع، الرد بيرجع للقواعد بدل ما العميل يستنى.

ANTHROPIC_API_KEY=sk-ant-...
SUPPORT_MODEL=claude-sonnet-5

# مفتاح مجاني من: https://aistudio.google.com/apikey (حساب جوجل، من غير كارت)
#
# مهم: جوجل بتستخدم رسايل الطبقة المجانية في تدريب موديلاتها. عشان كده أسئلة
# الأوردرات (فيها اسم العميل وعنوانه ورقم طلبه) بتفضل على محرك القواعد المحلي
# ومبتتبعتش لجوجل. ده بيتلغى تلقائياً لو حطيت مفتاح Claude، لأن المدفوع مش
# بيتدرب عليه.
GEMINI_API_KEY=

# سيبها فاضية. الكود جواه لستة موديلات بيمشي عليها بالترتيب: لو موديل اتشال من
# جوجل (بيرد 404) أو كان مزنوق (بيرد 503) بيروح للي بعده على طول. متحطش قيمة هنا
# غير لو جوجل شالت موديل ولازم تغيّره من غير deploy — وساعتها اكتب أكتر من واحد
# مفصولين بفاصلة، مش واحد بس:
#   GEMINI_MODEL=gemini-3.6-flash,gemini-flash-latest
GEMINI_MODEL=

# لينكات المنتجات اللي المساعد بيبعتها للعميل
SITE_URL=https://belgmla.com

# ── Meta (واتساب + إنستجرام + ماسنجر: أبلكيشن واحد) ──
# App Secret من: developers.facebook.com → التطبيق → Settings → Basic
META_APP_SECRET=

# كلمة سر بتخترعها إنت، وبتكتبها مرتين: هنا، وفي خانة Verify Token
# في صفحة الـ Webhook داخل التطبيق.
META_VERIFY_TOKEN=

# نسخة Graph API. سيبها زي ما هي إلا لو Meta طلبت غيرها.
GRAPH_VERSION=v23.0

# ── واتساب ──
# WhatsApp → API Setup: "Phone number ID" مش رقم التليفون نفسه
WHATSAPP_PHONE_NUMBER_ID=
# توكن دائم من System User (مش التوكن المؤقت بتاع 24 ساعة)
WHATSAPP_TOKEN=

# ── إنستجرام ──
IG_ACCOUNT_ID=
IG_TOKEN=
# سيبها فاضية لو التطبيق بيستخدم Facebook Login.
# حطها https://graph.instagram.com لو بيستخدم Instagram Login.
IG_GRAPH_BASE=

# ── ماسنجر ──
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ── تيك توك (عن طريق Messaging Partner) ──
# تيك توك مالهاش DM API عام. الشريك بيبعتلنا الرسالة على
# /api/social/webhook/tiktok وبناخد الرد ونبعتهوله على اللينك ده.
TIKTOK_RELAY_URL=
TIKTOK_RELAY_TOKEN=

# ── تنبيهات الفريق ──
# رقم واتساب (بصيغة دولية من غير +) يوصله إشعار بكل أوردر جديد
# وكل محادثة محتاجة موظف بشري.
SOCIAL_ALERT_WHATSAPP=201125210210
