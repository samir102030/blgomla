# ─────────────────────────────────────────────────────────────────────────────
#  المساعد الذكي على السوشيال ميديا — متغيرات البيئة
#  انسخ اللي محتاجه من هنا وحطه في Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── المخ (Claude) ──
# لو المفتاح ده مش موجود، السيرفس هيشتغل بمحرك القواعد بس (ردود أقل ذكاءً
# لكن الشات مش هيقف). ده مقصود.
ANTHROPIC_API_KEY=sk-ant-...
SUPPORT_MODEL=claude-sonnet-5

# لينكات المنتجات اللي المساعد بيبعتها للعميل
SITE_URL=https://belgmla.com

# ── Meta (واتساب + إنستجرام + ماسنجر: أبلكيشن واحد) ──
# App Secret من: developers.facebook.com → التطبيق → Settings → Basic
META_APP_SECRET=

# كلمة سر بتخترعها إنت، وبتكتبها مرتين: هنا، وفي خانة Verify Token
# في صفحة الـ Webhook داخل التطبيق.
META_VERIFY_TOKEN=

# نسخة Graph API. سيبها زي ما هي إلا لو Meta طلبت غيرها.
GRAPH_VERSION=v23.0

# ── واتساب ──
# WhatsApp → API Setup: "Phone number ID" مش رقم التليفون نفسه
WHATSAPP_PHONE_NUMBER_ID=
# توكن دائم من System User (مش التوكن المؤقت بتاع 24 ساعة)
WHATSAPP_TOKEN=

# ── إنستجرام ──
IG_ACCOUNT_ID=
IG_TOKEN=
# سيبها فاضية لو التطبيق بيستخدم Facebook Login.
# حطها https://graph.instagram.com لو بيستخدم Instagram Login.
IG_GRAPH_BASE=

# ── ماسنجر ──
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ── تيك توك (عن طريق Messaging Partner) ──
# تيك توك مالهاش DM API عام. الشريك بيبعتلنا الرسالة على
# /api/social/webhook/tiktok وبناخد الرد ونبعتهوله على اللينك ده.
TIKTOK_RELAY_URL=
TIKTOK_RELAY_TOKEN=

# ── تنبيهات الفريق ──
# رقم واتساب (بصيغة دولية من غير +) يوصله إشعار بكل أوردر جديد
# وكل محادثة محتاجة موظف بشري.
SOCIAL_ALERT_WHATSAPP=201125210210
