{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/post-purchase",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/cart-recovery",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sale-scheduler",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/stock-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/student-programme",
      "schedule": "30 3 * * *"
    }
  ]
}
