# ─── Sample .env for Belgomla Backend ───
# Copy this to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prod

# Auth
JWT_SECRET=your-32-byte-hex-secret
JWT_REFRESH_SECRET=your-32-byte-hex-secret

# Email (Resend — https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=Belgomla <noreply@belgomla.com>

# Payment: Stripe (International — https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment: Paymob (Egypt — https://paymob.com)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Paymob installments / BNPL (ValU, Souhoola). Separate integration ID from your
# Paymob dashboard. Falls back to PAYMOB_IFRAME_ID if no installment iframe set.
PAYMOB_INSTALLMENT_INTEGRATION_ID=
PAYMOB_INSTALLMENT_IFRAME_ID=

# Shipping: Bosta live rates (https://bosta.co). Leave unset to use the admin
# zone rates configured in the dashboard. Confirm endpoint vs your account.
BOSTA_API_KEY=
BOSTA_API_URL=https://app.bosta.co/api/v2
BOSTA_PICKUP_CITY=Cairo

# Shipping: Accurate (accuratess.com) GraphQL carrier. Credentials are created
# by the carrier and emailed to the integrator. Leave unset to disable; when set
# it takes priority over Bosta, then falls back to admin zone rates. Configure
# serviceId / sender / governorate->zone map in the dashboard (/api/accurate).
ACCURATE_USERNAME=
ACCURATE_PASSWORD=
ACCURATE_API_URL=https://qimmah.lg.accuratess.com:8443/graphql

# SMS notifications. Set SMS_PROVIDER to "twilio" or "vonage" to enable.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Belgomla

# Error monitoring: Sentry (https://sentry.io). Leave unset to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cron auth: shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Required for /api/cron/* (abandoned-cart recovery). Generate: openssl rand -hex 32
CRON_SECRET=

# Web Push (browser push notifications). Generate VAPID keys once with:
#   node -e "import('web-push').then(m=>{ const k=m.default.generateVAPIDKeys(); console.log(k); })"
# Then paste below. VAPID_PUBLIC_KEY is also exposed to the frontend via /api/notifications/push-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=noreply@belgomla.com
