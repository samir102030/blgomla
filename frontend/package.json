{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:watch": "nodemon --exec \"npm run dev\"",
    "sitemap": "node scripts/generate-sitemap.mjs",
