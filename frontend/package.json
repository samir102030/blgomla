    "@react-oauth/google": "^0.13.5",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "^5.100.10",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.11.0",
    "belgomla": "file:..",
    "i18next": "^25.7.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
