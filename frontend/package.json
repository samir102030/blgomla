    "build:typecheck": "tsc -b && node scripts/generate-sitemap.mjs && vite build --config vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
