VITE_API_URL=http://localhost:5000/api
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
VITE_GA_MEASUREMENT_ID=
# Sentry error monitoring (https://sentry.io). Leave unset to disable. Only active in production builds.
VITE_SENTRY_DSN=
# Build-time sitemap: production API base used to enumerate product/collection URLs.
# Falls back to VITE_API_URL. Set in Vercel build env to your live API for a full sitemap.
SITEMAP_API_URL=
# Public site origin used for sitemap <loc> URLs.
SITE_URL=https://halafawystore-frontend.vercel.app
